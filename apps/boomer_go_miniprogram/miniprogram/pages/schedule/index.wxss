.schedule-page { padding-bottom: calc(70rpx + env(safe-area-inset-bottom)); }
.eyebrow { color: #eb0029; font-size: 22rpx; letter-spacing: 3rpx; margin: 12rpx 0 16rpx; }
.page-title { font-size: 48rpx; font-weight: 700; }
.intro { margin: 16rpx 0 32rpx; }
.calendar { padding: 20rpx 16rpx; }
.calendar-header { margin-bottom: 24rpx; }
.month-arrow { width: 88rpx; min-height: 88rpx; line-height: 88rpx; padding: 0; font-size: 48rpx; background: #f6f7f9; color: #202125; }
.month-title { font-size: 34rpx; font-weight: 600; padding: 24rpx 12rpx; min-height: 88rpx; }
.calendar-grid { display: flex; flex-wrap: wrap; }
.weekday { width: 14.2857%; text-align: center; color: #737780; font-size: 24rpx; padding: 14rpx 0; }
.day-cell { width: 14.2857%; min-height: 114rpx; text-align: center; border-radius: 16rpx; padding-top: 10rpx; border: 2rpx solid transparent; }
.day-cell.selected { background: #fff0f3; border-color: #eb0029; }
.day-number { font-size: 30rpx; line-height: 42rpx; }
.shift-dot { width: 10rpx; height: 10rpx; background: #eb0029; border-radius: 50%; margin: 6rpx auto 0; }
.shift-count { font-size: 20rpx; color: #737780; line-height: 28rpx; }
.blank { opacity: 0; }
.calendar-note { font-size: 22rpx; line-height: 1.7; margin: 24rpx 12rpx 8rpx; }
.list-heading .section-title { font-size: 30rpx; margin: 20rpx 0 24rpx; }
.show-all { color: #eb0029; background: transparent; font-size: 25rpx; min-height: 88rpx; padding: 22rpx 0; }
.shift-card { align-items: stretch; }
.date-rail { color: #eb0029; border-left: 5rpx solid #eb0029; padding-left: 16rpx; width: 170rpx; font-size: 26rpx; line-height: 1.7; }
.shift-main { flex: 1; min-width: 0; }
.shift-title { margin: 0 0 12rpx; font-size: 32rpx; }
.shift-time { font-size: 30rpx; margin-bottom: 10rpx; }
.shift-note { margin-top: 12rpx; line-height: 1.7; }
.freshness { text-align: center; font-size: 22rpx; margin-top: 24rpx; }
.empty .muted { margin-top: 16rpx; }
.loading-state { padding: 48rpx; text-align: center; color: #737780; }
.view-switch { gap: 12rpx; margin-bottom: 24rpx; padding: 8rpx; background: #eceef1; border-radius: 20rpx; }
.view-option { flex: 1; min-height: 88rpx; padding: 22rpx 16rpx; background: transparent; color: #737780; font-size: 28rpx; line-height: 1.5; }
.view-option.active { background: #fff0f3; color: #eb0029; font-weight: 600; }
.view-option[disabled] { color: #737780; background: #f5f6f8; }
.notice { color: #737780; line-height: 1.8; font-size: 26rpx; }
.rest-label { font-size: 20rpx; color: #737780; line-height: 28rpx; }
.rest-card .date-rail { color: #737780; border-left-color: #c5c9d0; }
.rest-card .shift-title { color: #737780; }
.rest-description { margin-bottom: 12rpx; }
.shift-shop, .shift-title, .member, .group-shop, .conflict-line { overflow-wrap: anywhere; word-break: break-all; }
.conflict-notice { border: 2rpx solid #eb0029; }
.conflict-notice .section-title, .conflict-line { color: #b30020; line-height: 1.7; }
.conflict-notice .muted { margin-top: 12rpx; line-height: 1.7; }
.group-date { color: #eb0029; font-size: 26rpx; line-height: 1.7; margin-bottom: 18rpx; }
.group-shop { display: block; }
.group-heading { gap: 16rpx; align-items: flex-start; margin-bottom: 12rpx; }
.group-heading .section-title { margin: 0; flex: 1; }
.group-heading .muted { flex-shrink: 0; font-size: 24rpx; }
.members { display: flex; flex-wrap: wrap; gap: 12rpx; }
.member { padding: 10rpx 18rpx; border-radius: 12rpx; background: #f5f6f8; color: #202125; font-size: 26rpx; line-height: 1.7; max-width: 100%; }
.member-self { background: #fff0f3; color: #b30020; }
