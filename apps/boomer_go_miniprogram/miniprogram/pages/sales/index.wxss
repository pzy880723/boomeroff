.sales-page { padding-bottom: 70rpx; }
.eyebrow { color: #eb0029; font-size: 22rpx; letter-spacing: 3rpx; margin: 12rpx 0 16rpx; }
.page-title { font-size: 48rpx; font-weight: 700; }
.display-badge { font-size: 22rpx; color: #eb0029; background: #fff0f3; padding: 6rpx 14rpx; border-radius: 10rpx; margin-left: 20rpx; vertical-align: middle; }
.shop-name { margin: 16rpx 0 24rpx; }
.notice { padding: 24rpx; background: #edf2ff; color: #315acb; border-radius: 20rpx; font-size: 25rpx; line-height: 1.8; }
.source-notice { margin-bottom: 24rpx; }
.period-row { justify-content: flex-start; margin: 28rpx 0; }
.period { min-height: 88rpx; line-height: 88rpx; padding: 0 32rpx; border-radius: 20rpx; color: #737780; background: #fff; font-size: 28rpx; }
.period.selected { background: #fff0f3; color: #eb0029; font-weight: 600; }
.type-tabs { margin-bottom: 24rpx; border-bottom: 1rpx solid #e0e2e7; }
.type-tab { flex: 1; color: #737780; background: transparent; border-radius: 0; min-height: 96rpx; line-height: 96rpx; padding: 0; font-size: 30rpx; }
.type-tab.active { color: #eb0029; border-bottom: 5rpx solid #eb0029; font-weight: 600; }
.metrics-grid { display: flex; flex-wrap: wrap; margin: 0 -8rpx; }
.metric { width: 46%; margin: 8rpx 2%; padding: 26rpx 20rpx; min-height: 180rpx; }
.metric-label { font-size: 24rpx; }
.metric-value { font-size: 36rpx; font-weight: 600; line-height: 1.5; word-break: break-all; margin-top: 22rpx; }
.leaderboard { padding: 0 24rpx; }
.leaderboard-head { padding: 24rpx 0; font-size: 23rpx; color: #737780; border-bottom: 1rpx solid #eceef2; }
.leaderboard-row { min-height: 110rpx; padding: 20rpx 0; border-bottom: 1rpx solid #eceef2; font-size: 28rpx; }
.leaderboard-row:last-child { border-bottom: none; }
.rank { width: 70rpx; flex-shrink: 0; text-align: center; }
.rank-value { color: #eb0029; font-size: 30rpx; font-weight: 600; }
.staff-name { flex: 1; min-width: 0; word-break: break-all; }
.revenue { font-size: 27rpx; font-weight: 600; }
.freshness { text-align: center; font-size: 22rpx; margin-top: 28rpx; }
.data-note { font-size: 23rpx; line-height: 1.8; margin-top: 32rpx; }
.empty .muted { margin-top: 16rpx; }
.loading-state { padding: 48rpx; text-align: center; color: #737780; }
