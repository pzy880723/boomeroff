.login{padding-top:72rpx}.brand{width:290rpx;height:80rpx;display:block;margin-bottom:50rpx}.login .title{font-size:64rpx;font-weight:750;line-height:1.35}.intro{margin-bottom:60rpx}.login .section-title{margin:0 0 34rpx;font-size:35rpx}.code-row{display:flex;align-items:center;gap:12rpx;margin:20rpx 0 30rpx}.code{width:55%}.send{width:43%;min-height:90rpx;display:flex;align-items:center;justify-content:center;background:#FFF0F3;color:#EB0029;font-size:26rpx}.message{font-size:25rpx;color:#267750;margin:12rpx 0 24rpx}.retry{margin-top:18rpx;font-size:25rpx}.notice{padding:20rpx;line-height:1.8}.preview-button{background:transparent;font-size:26rpx;color:#737780;padding:28rpx}
.login-modes{display:flex;padding:6rpx;background:#F5F6F8;border-radius:18rpx;margin-bottom:30rpx}.mode-button{flex:1;min-width:0;min-height:88rpx;line-height:1.4;padding:24rpx 8rpx;border-radius:14rpx;background:transparent;color:#737780;font-size:29rpx;font-weight:600}.mode-button.mode-active{background:#FFF;color:#EB0029}.password-field{margin-top:20rpx}.forgot-password{margin:6rpx 0 20rpx auto;background:transparent;color:#737780;min-height:88rpx;padding:22rpx 0 22rpx 20rpx;font-size:26rpx;text-align:right;width:auto}
