<view class="page login">
  <image src="/assets/wordmark.png" class="brand" mode="aspectFit"/>
  <view class="title">让门店工作<br/>更轻松一点。</view>
  <view class="muted intro">公司与加盟门店的员工工作台</view>
  <view class="card">
    <view class="login-modes">
      <button class="mode-button {{mode === 'otp' ? 'mode-active' : ''}}" data-mode="otp" bindtap="switchMode" disabled="{{submitting || sending}}">手机验证码</button>
      <button class="mode-button {{mode === 'password' ? 'mode-active' : ''}}" data-mode="password" bindtap="switchMode" disabled="{{submitting || sending}}">账号密码</button>
    </view>
    <view class="section-title">{{mode === 'otp' ? '员工手机号登录' : '员工账号密码登录'}}</view>
    <block wx:if="{{mode === 'otp'}}">
      <input class="field" type="number" maxlength="11" placeholder="已在 ERP 登记的手机号" value="{{phone}}" bindinput="phoneInput" disabled="{{submitting || sending}}"/>
      <view class="code-row">
        <input class="field code" type="number" maxlength="6" placeholder="6 位验证码" value="{{code}}" bindinput="codeInput" disabled="{{submitting || sending}}"/>
        <button class="send" disabled="{{sending || seconds > 0 || submitting || preview}}" bindtap="send">{{sending ? '发送中…' : seconds > 0 ? seconds + 's 后重发' : '获取验证码'}}</button>
      </view>
    </block>
    <block wx:else>
      <input class="field" type="text" maxlength="255" placeholder="手机号 / 用户名 / 邮箱" value="{{account}}" bindinput="accountInput" disabled="{{submitting || sending}}"/>
      <input class="field password-field" type="text" password="{{true}}" maxlength="-1" placeholder="请输入原有账号密码" value="{{password}}" bindinput="passwordInput" disabled="{{submitting || sending}}"/>
      <button class="forgot-password" bindtap="forgotPassword" disabled="{{submitting || sending}}">忘记密码？</button>
    </block>
    <view wx:if="{{message}}" class="message">{{message}}</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="button" bindtap="submit" disabled="{{submitting || sending || preview}}" loading="{{submitting}}">{{submitting ? '正在验证员工身份' : '登录工作台'}}</button>
    <button wx:if="{{retryRestore}}" class="button-secondary retry" bindtap="restore" disabled="{{submitting || sending || preview}}">重试连接，不重新登录</button>
  </view>
  <view class="muted notice">仅已登记员工可访问。微信身份绑定将在专属员工小程序开通后启用，不与消费者账号混用。</view>
  <button wx:if="{{canPreview}}" class="preview-button" bindtap="enterPreview" disabled="{{submitting || sending}}">查看初版界面（示例数据）</button>
</view>
