<view class="page detail-page">
  <view wx:if="{{preview}}" class="preview-banner">开发预览 · 合成演示内容，非真实员工记录</view>
  <view wx:if="{{practiceRequested}}" class="notice"><view>{{practiceNote}}</view><button class="button-secondary" bindtap="returnPractice">返回本轮清单，可显式跳过不可用条目</button></view>
  <view wx:if="{{loading}}" class="card loading-state">正在获取内容…</view>
  <view wx:if="{{error}}" class="card error"><text>{{error}}</text><button class="button-secondary" bindtap="retry">重新加载</button></view>
  <view wx:if="{{resolvedMessage}}" class="card resolved-state"><view class="section-title">{{resolvedMessage}}</view><button class="button-secondary" data-url="{{resolvedUrl}}" bindtap="go">返回列表</button></view>
  <view wx:if="{{!loading && !error && !item && !resolvedMessage}}" class="card empty">内容不存在、已移除，或当前账号无权访问。</view>
  <block wx:if="{{item}}">
    <view class="article-heading"><text class="chip">{{item.category}}</text><view class="article-title">{{item.title}}</view><view wx:if="{{item.author}}" class="muted">{{item.author}}</view><view class="muted freshness">{{freshness}}</view></view>
    <image wx:if="{{item.cover_url}}" class="article-cover" src="{{item.cover_url}}" mode="widthFix" />
    <view wx:if="{{kind === 'profile'}}" class="card profile-editor"><view class="section-title">昵称与头像</view><view class="row avatar-editor"><image wx:if="{{avatarPreview}}" src="{{avatarPreview}}" class="profile-avatar" mode="aspectFill" /><view wx:else class="profile-avatar avatar-empty">头像</view><button class="button-secondary" bindtap="chooseAvatar" disabled="{{busy}}">从相册选择头像</button></view><view class="muted profile-label">昵称（1-30 个字）</view><input class="field" value="{{profileNameDraft}}" bindinput="onProfileNameInput" maxlength="60" placeholder="输入昵称" disabled="{{busy}}" /><view class="muted action-hint">仅昵称和头像可修改。ERP 真实姓名、手机号、角色与门店均为只读。</view><button class="button profile-save" bindtap="saveProfile" loading="{{busy}}" disabled="{{busy}}">保存并核对资料</button></view>
    <view wx:if="{{kind !== 'conversation' && kind !== 'profile' && kind !== 'tasks' && kind !== 'objectives' && (nodes.length || !businessSections.length)}}" class="card article"><rich-text nodes="{{nodes}}" selectable /><view wx:if="{{!nodes.length}}" class="muted">服务器暂未提供正文，请查看下方信息。</view></view>
    <view wx:if="{{fields.length}}" class="card"><view class="section-title">详细信息</view><view wx:for="{{fields}}" wx:key="index" class="field-row"><view class="muted field-label">{{item.label}}</view><text selectable class="field-value">{{item.value}}</text></view></view>
    <view wx:for="{{businessSections}}" wx:key="title" wx:for-item="section" class="card business-section"><view class="section-title">{{section.title}}</view><view wx:for="{{section.entries}}" wx:key="index" class="business-entry"><text wx:if="{{item.tag}}" class="chip business-tag">{{item.tag}}</text><view wx:if="{{item.title}}" class="business-entry-title"><text selectable>{{item.title}}</text></view><text wx:if="{{item.body}}" selectable class="business-entry-body">{{item.body}}</text></view></view>
    <view wx:if="{{gallery.length}}" class="card"><view class="section-title">商品图片</view><image wx:for="{{gallery}}" wx:key="*this" class="business-image" src="{{item}}" mode="widthFix" /></view>
    <view wx:if="{{backstampUrl}}" class="card"><view class="section-title">底款细节</view><image class="business-image" src="{{backstampUrl}}" mode="widthFix" /></view>
    <view wx:if="{{videoUrl}}" class="card"><view class="section-title">商品视频</view><video class="business-video" src="{{videoUrl}}" controls /></view>
    <view wx:if="{{results.length}}" class="card"><view class="section-title">关键结果</view><view wx:for="{{results}}" wx:key="index" class="result-row row"><text class="result-marker {{item.completed ? 'done' : ''}}">{{item.completed ? '✓' : '·'}}</text><text class="result-text">{{item.title}}</text></view></view>
    <button wx:if="{{quizUrl}}" class="button" data-url="{{quizUrl}}" bindtap="openQuiz">练习这条知识</button>
    <view wx:if="{{learningNotice}}" class="notice">{{learningNotice}}</view>
    <view wx:if="{{canFavorite}}" class="cloud-actions"><button class="button-secondary" bindtap="toggleFavorite" disabled="{{busy}}" loading="{{busy}}">{{favorite ? '取消收藏' : '收藏知识'}}</button></view>
    <view wx:if="{{canRemoveFavorite}}" class="cloud-actions"><button class="button-secondary" bindtap="confirmFavoriteRemoval" disabled="{{busy}}" loading="{{busy}}">移除这条收藏</button></view>
    <view wx:if="{{canSave}}" class="cloud-actions"><button class="button-secondary" bindtap="saveKnowledge" disabled="{{busy}}">保存已有商品到我的知识库</button></view>
    <view wx:if="{{canShare}}" class="cloud-actions"><button class="button-secondary" bindtap="confirmShare" disabled="{{busy}}">分享商品到 BOOMER 圈</button></view>
    <view wx:if="{{kind === 'tasks'}}" class="cloud-actions"><button class="button" bindtap="claimTask" disabled="{{busy || claimed || !completed}}" loading="{{busy}}">{{claimed ? '云端已领取' : (completed ? '向云端申请领取奖励' : '未达标，继续完成任务')}}</button><view class="muted action-hint">完成状态和奖励资格由服务器核验，不会本地标记完成。</view></view>
    <view wx:if="{{kind === 'tasks'}}" class="row task-links"><button class="button-secondary" data-url="/pages/recognize/index" bindtap="go">去识物</button><button class="button-secondary" data-url="/pages/learn/index" bindtap="go">去学习</button></view>
    <view wx:if="{{kind === 'objectives'}}" class="notice">仅用于门店协作。营业额展示与知识测验、员工考核及处罚分离。</view>
    <view wx:if="{{kind === 'objectives'}}" class="card objective-editor"><view class="section-title">编辑协作进度</view><view class="muted">保存权限由服务器按当前账号及目标归属核验；能阅读不代表获准修改。修改不会本地标记完成，失败或结果未知不会自动重发。</view><view wx:for="{{draftResults}}" wx:key="index" class="row draft-row"><text class="draft-title">{{item.title}}</text><switch color="#EB0029" checked="{{item.completed}}" data-index="{{index}}" bindchange="onKeyResultChange" disabled="{{busy || objectiveBlocked || !item.editable || preview}}" /></view><textarea class="field action-textarea" value="{{keyActionsDraft}}" bindinput="onKeyActionsInput" maxlength="4000" placeholder="填写门店关键行动，不用于销售额考核" disabled="{{busy || objectiveBlocked || preview}}" /><view class="muted">关键行动最多 4000 个字符。重新读取会先确认放弃未保存草稿。</view><button class="button" bindtap="saveObjective" loading="{{busy}}" disabled="{{busy || objectiveBlocked || !objectiveDirty || preview}}">保存协作进度</button><button class="button-secondary" bindtap="reloadObjective" disabled="{{busy || loading}}">重新读取云端内容</button></view>
    <view wx:if="{{kind === 'conversation'}}" class="conversation"><view class="notice">这里是 BOOMER AI 助手会话，不是同事私信。</view><view wx:if="{{!messages.length}}" class="card empty">还没有助手对话。输入内容即可与 BOOMER 助手交流。</view><view wx:for="{{messages}}" wx:key="id" class="message-bubble {{item.role === 'user' ? 'from-user' : ''}}"><view class="muted message-role">{{item.role === 'user' ? '我' : 'BOOMER 助手'}}</view><text selectable class="message-content">{{item.content}}</text><view wx:if="{{item.time}}" class="muted message-time">{{item.time}}</view></view><view class="card message-composer"><textarea value="{{messageDraft}}" bindinput="onMessageInput" maxlength="5000" placeholder="向 BOOMER 助手提问，失败时保留草稿" disabled="{{busy}}" class="field message-input" /><button class="button" bindtap="sendMessage" disabled="{{busy || !messageDraft}}" loading="{{busy}}">{{busy ? '发送中' : '发送给助手'}}</button></view></view>
    <view wx:if="{{actionNotice}}" class="notice">{{actionNotice}}</view>
    <view wx:if="{{kind === 'activities'}}" class="action-status"><button class="button-secondary" bindtap="openActivity">查看活动与申请</button></view>
    <view wx:if="{{kind === 'community' || kind === 'vouchers' || kind === 'settings'}}" class="action-status"><button class="button-secondary" bindtap="explainUnavailable">查看操作支持情况</button><view wx:if="{{unavailable}}" class="notice">{{unavailable}}</view></view>
  </block>
</view>
