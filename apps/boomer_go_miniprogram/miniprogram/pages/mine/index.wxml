<view class="page mine-page">
  <view wx:if="{{preview}}" class="preview-banner">开发预览 · 合成员工资料，非真实账号状态</view>
  <view class="eyebrow">BOOMER / ME</view><view class="page-title">我的</view>
  <view wx:if="{{loading}}" class="card loading-state">正在获取员工资料…</view>
  <view wx:if="{{error}}" class="card error"><text>{{error}}</text><button class="button-secondary" bindtap="retry">重试同步</button></view>
  <view wx:if="{{!loading && !error && !profile}}" class="card empty">暂无已同步员工资料</view>
  <view wx:if="{{profile}}" class="card identity-card"><view class="row identity-row"><image wx:if="{{profile.avatar}}" class="avatar" src="{{profile.avatar}}" mode="aspectFill" /><view wx:else class="avatar initial">{{profile.initial}}</view><view class="identity-main"><view class="employee-name">{{profile.name}}</view><view class="muted identity-role">{{profile.role}}</view></view><text class="employee-badge">员工</text></view><view class="shop-block"><view class="muted shop-label">当前工作门店</view><view class="shop-name">{{profile.shop}}</view><picker wx:if="{{isHeadquarters && shops.length}}" range="{{shops}}" range-key="name" value="{{shopIndex}}" bindchange="onShopChange"><view class="switch-shop">切换已授权门店 →</view></picker></view><view class="row experience-row"><text class="muted">云端成长经验</text><text class="experience">{{profile.experience}}</text></view></view>
  <block wx:for="{{groups}}" wx:key="title" wx:for-item="group"><view class="section-title group-title">{{group.title}}</view><view class="card menu-group"><view wx:for="{{group.entries}}" wx:key="url" class="row menu-row" data-url="{{item.url}}" bindtap="go" hover-class="pressed"><text class="menu-icon">{{item.icon}}</text><text class="menu-label">{{item.label}}</text><text class="menu-arrow">›</text></view></view></block>
  <view wx:if="{{freshness}}" class="muted freshness">{{freshness}}</view><button class="button-secondary logout" bindtap="logout" disabled="{{signingOut}}">{{preview ? '退出开发预览' : '退出登录'}}</button><view class="muted privacy-note">工作数据遵循 ERP 员工与门店权限。</view>
</view>
