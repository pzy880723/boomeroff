.assistant-page { height: 100vh; box-sizing: border-box; display: flex; flex-direction: column; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.assistant-header { align-items: flex-start; gap: 20rpx; margin-bottom: 24rpx; }
.assistant-header button { flex-shrink: 0; margin: 0; }
.conversation { flex: 1; min-height: 0; height: 0; }
.message { border-radius: 24rpx; padding: 24rpx; margin: 0 48rpx 24rpx 0; background: #fff; line-height: 1.8; }
.message-user { background: #fff0f3; margin-left: 48rpx; margin-right: 0; }
.message-text { white-space: pre-wrap; word-break: break-word; }
.copy-message { padding: 0; text-align: left; background: transparent; font-size: 24rpx; color: #315acb; min-height: 88rpx; }
.copy-message::after { border: 0; }
.composer { display: flex; align-items: flex-end; gap: 16rpx; margin-bottom: 0; }
.composer textarea { flex: 1; width: auto; min-height: 88rpx; max-height: 240rpx; padding: 14rpx 0; box-sizing: border-box; }
.composer button { flex-shrink: 0; margin: 0; }
