.category-page{padding-bottom:80rpx}.category-heading{margin:10rpx 0 22rpx}.category-heading .title{margin:0}.create-category{min-width:136rpx}.category-help{line-height:1.8;margin:18rpx 0 26rpx}.category-name{font-size:34rpx;font-weight:650;line-height:1.6;word-break:break-all;margin:22rpx 0}.category-item button{width:100%}.inline-editor .section-title,.pending-overview .section-title{font-size:33rpx;margin:0 0 18rpx}.inline-editor .row{align-items:flex-start}.inline-editor .badge{flex-shrink:0}.field-label{font-size:30rpx;font-weight:650;margin:24rpx 0 14rpx}.field-label .muted{margin-left:10rpx;font-weight:400}.inline-editor input{height:100rpx}.inline-editor button,.pending-overview button,.error button{margin-top:22rpx}.category-notice{font-size:28rpx;line-height:1.8;word-break:break-all;background:#FFF4DC;color:#8A5D12;border-radius:20rpx;padding:24rpx;margin:22rpx 0}.category-notice.verified{background:#EAF5EE;color:#28633D}.category-notice button{margin-top:20rpx}.delete-category{color:#C30026!important;border-color:#F1C9D1!important}.category-count{text-align:center;margin:24rpx 0}.pending-state{border-top:1rpx solid #ECEEF2;margin-top:24rpx}.inline-editor{border-color:#E0E3E9}
