.manual-copy-page{padding-bottom:90rpx}.heading-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.shop-name{margin-top:16rpx}.scope-note{font-size:26rpx;line-height:1.8;color:#656B75;margin:20rpx 0 26rpx}.notice{background:#FFF4DC;color:#805B1C;padding:24rpx;border-radius:18rpx;font-size:28rpx;line-height:1.8;margin:24rpx 0;word-break:break-all}.confirmed-notice{background:#EAF5EE;color:#28633D}.editor-card,.pending-card,.conflict-card{margin-top:24rpx}.field-label{font-size:30rpx;font-weight:650;margin:28rpx 0 14rpx}.field-label:first-child{margin-top:0}.field-label .muted{font-weight:400;margin-left:16rpx}.candidate-picker{display:flex;justify-content:space-between;align-items:center;min-height:92rpx;line-height:1.6;word-break:break-all}.candidate-picker text{margin-left:20rpx;color:#797D85}.input-help{font-size:25rpx;margin-top:14rpx;line-height:1.8}.title-input{height:100rpx}.body-input{min-height:440rpx;line-height:1.9;word-break:break-all}.input-count{text-align:right;margin-top:12rpx;font-size:24rpx;line-height:1.7}.validation{font-size:27rpx;line-height:1.8;color:#B80024;margin-top:22rpx}.save-button{margin-top:30rpx}.delete-button{color:#C30026!important;border-color:#F1C9D1!important;margin-top:22rpx}.reload-button,.library-button{margin-top:24rpx}.pending-card .section-title,.conflict-card .section-title{margin:0 0 18rpx}.pending-card .muted,.conflict-card .muted{font-size:26rpx;line-height:1.8;word-break:break-all}.intent-id{margin-bottom:18rpx}.pending-card button,.error button{margin-top:24rpx}.conflict-card{border-color:#F1C9D1}.loading-state{font-size:28rpx;line-height:1.8}
