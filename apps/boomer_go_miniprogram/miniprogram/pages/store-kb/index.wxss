.kb-page{padding-bottom:70rpx}.kb-header{margin:10rpx 0 26rpx}.kb-header .title{margin:0}.new-button{min-width:136rpx}.kb-tabs{background:#E9EBEF;padding:6rpx;border-radius:20rpx;gap:6rpx}.kb-tab{flex:1;min-height:88rpx;background:transparent;color:#737780;padding:20rpx 10rpx;font-weight:600}.kb-tab.selected{background:#fff;color:#EB0029;box-shadow:0 3rpx 8rpx rgba(0,0,0,.04)}.search{padding:10rpx 18rpx}.search input{flex:1;min-width:0;font-size:30rpx;min-height:88rpx}.search-button{background:transparent;color:#EB0029;min-width:100rpx;min-height:88rpx;padding:22rpx 10rpx}.category-scroll{width:100%;margin-bottom:10rpx}.category-line{display:flex;white-space:nowrap}.category-line .chip{flex-shrink:0;min-height:88rpx}.scope-help{margin:12rpx 0 28rpx}.kb-item{word-break:break-all}.item-title{font-size:34rpx;font-weight:700;margin:22rpx 0 10rpx;line-height:1.5}.item-preview{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:20rpx}.tag{font-size:23rpx;color:#656B75;background:#F1F3F6;border-radius:10rpx;padding:6rpx 12rpx;word-break:break-all}.tag.highlight{color:#C30026;background:#FFF0F3}.item-link{margin-top:20rpx;text-align:right}.loaded-count{text-align:center;margin:28rpx 0}.article-title{font-size:40rpx;line-height:1.5;font-weight:700;margin:22rpx 0 10rpx;word-break:break-all}.markdown-block{font-size:30rpx;line-height:1.9;margin:20rpx 0;word-break:break-all;white-space:pre-wrap}.markdown-heading{font-size:35rpx;font-weight:700;margin-top:34rpx}.markdown-list{display:flex;align-items:flex-start}.markdown-list rich-text{flex:1;min-width:0}.list-marker{color:#EB0029;margin-right:18rpx;font-weight:700}.markdown-table{width:100%;margin:26rpx 0}.table-inner{display:table;border-left:1rpx solid #DFE2E7;border-top:1rpx solid #DFE2E7}.table-row{display:table-row}.table-cell{display:table-cell;min-width:180rpx;padding:18rpx;border-right:1rpx solid #DFE2E7;border-bottom:1rpx solid #DFE