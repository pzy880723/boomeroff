.editor-page{padding-bottom:80rpx}.editor-page .title{margin-bottom:20rpx}.notice{font-size:28rpx;line-height:1.7;color:#8A5D12;background:#FFF4DC;border-radius:20rpx;padding:24rpx;margin:24rpx 0;word-break:break-all}.verified-notice{background:#EAF5EE;color:#28633D}.editor-card{margin-top:24rpx}.field-label{font-size:30rpx;font-weight:650;margin:28rpx 0 14rpx}.field-label:first-child{margin-top:0}.field-label .muted{font-weight:400;margin-left:12rpx}.title-input{height:102rpx}.body-input{min-height:400rpx;line-height:1.9;word-break:break-all}.tags-input{min-height:112rpx;line-height:1.7}.input-help{margin-top:12rpx;line-height:1.7}.save-button{margin-top:30rpx}.delete-button{margin-top:22rpx;color:#C30026!important;border-color:#F1C9D1!important}.validation{font-size:27rpx;color:#B80024;margin:22rpx 0;line-height:1.7}.storage-note{margin-top:30rpx;line-height:1.8}.pending-card .section-title{margin:0 0 16rpx;font-size:33rpx}.pending-card button,.conflict-card button,.error button{margin-top:22rpx}.pending-card .error{margin-top:22rpx}.conflict-card{border-color:#F1C9D1}.conflict-card .muted{margin-top:12rpx}
.ai-panel{margin-top:24rpx;border:1rpx solid #E4E6EB;border-radius:18rpx;overflow:hidden}.ai-toggle{width:100%;background:#F7F8FA;padding:22rpx;min-height:92rpx;border-radius:0;font-size:30rpx;font-weight:600}.ai-panel>block{display:block}.ai-help{line-height:1.8;margin:18rpx 0}.ai-panel .ai-help,.ai-panel .ai-hint,.ai-panel .ai-count,.ai-panel .validation,.ai-panel>.button-secondary{margin-left:20rpx;margin-right:20rpx}.ai-hint{width:calc(100% - 40rpx);min-height:140rpx;background:white}.ai-count{text-align:right;margin-top:12rpx;margin-bottom:18rpx}.ai-panel button.button-secondary{margin:18rpx 20rpx 22rpx}.ai-error{margin:20rpx}.ai-candidate{padding:24rpx 20rpx;border-top:1rpx solid #E4E6EB}.ai-candidate-title{font-size:34rpx;font-weight:700;margin:22rpx 0 14rpx;line-height:1.6;word-break:break-all}.ai-tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:18rpx}.ai-tag{font-size:23rpx;padding:6rpx 12rpx;border-radius:10rpx;background:#F1F3F6;color:#656B75;word-break:break-all}.ai-tag.ai-highlight{background:#FFF0F3;color:#C30026}.ai-markdown{font-size:30rpx;line-height:1.9;white-space:pre-wrap;word-break:break-all;margin:20rpx 0}.ai-markdown-heading{font-size:34rpx;font-weight:700;margin-top:28rpx}.ai-markdown-list{display:flex;align-items:flex-start}.ai-markdown-list rich-text{flex:1;min-width:0}.ai-list-marker{margin-right:16rpx;color:#EB0029}.ai-table{width:100%;margin:24rpx 0}.ai-table-inner{display:table;border-left:1rpx solid #DFE2E7;border-top:1rpx solid #DFE2E7}.ai-table-row{display:table-row}.ai-table-header{background:#F5F6F8;font-weight:600}.ai-table-cell{display:table-cell;min-width:160rpx;padding:16rpx;font-size:28rpx;line-height:1.7;word-break:break-all;border-right:1rpx solid #DFE2E7;border-bottom:1rpx solid #DFE2E7}.ai-source{font-size:27rpx;color:#656B75;word-break:break-all;margin-top:12rpx}
