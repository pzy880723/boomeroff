.practice-page { padding-bottom: 70rpx; }
.eyebrow { color: #eb0029; font-size: 22rpx; letter-spacing: 3rpx; margin: 12rpx 0 16rpx; }
.page-title { color: #202125; font-size: 48rpx; font-weight: 700; line-height: 1.4; }
.intro { margin: 16rpx 0 30rpx; line-height: 1.7; }
.progress-heading, .queue-heading { justify-content: space-between; }
.progress-heading .section-title, .queue-heading .section-title { margin: 0; }
.progress-heading .chip, .queue-heading .chip { margin: 0 0 0 16rpx; font-size: 24rpx; white-space: nowrap; }
.practice-count { font-size: 72rpx; color: #eb0029; font-weight: 700; line-height: 1.3; margin: 24rpx 0 16rpx; }
.count-unit { font-size: 30rpx; font-weight: 400; }
.progress-card .muted, .window-note, .footer-note { font-size: 28rpx; line-height: 1.7; }
.window-note { margin: 26rpx 0; }
.window-note view { margin-top: 8rpx; }
.loading-state { text-align: center; padding: 48rpx 24rpx; color: #737780; }
.queue-row { padding: 26rpx 0; border-bottom: 1rpx solid #eceef1; min-height: 88rpx; box-sizing: border-box; }
.queue-number { width: 56rpx; height: 56rpx; flex-shrink: 0; border-radius: 18rpx; background: #f3f4f6; color: #737780; text-align: center; line-height: 56rpx; font-size: 28rpx; }
.queue-number.current { color: #eb0029; background: #ffedf0; }
.queue-title { flex: 1; min-width: 0; font-size: 32rpx; line-height: 1.6; margin: 0 20rpx; word-break: break-all; }
.queue-state { flex-shrink: 0; font-size: 26rpx; color: #737780; }
.queue-state.completed { color: #315acb; }
.queue-card .button { margin-top: 28rpx; }
.skip-note { font-size: 28rpx; line-height: 1.7; margin: 18rpx 0 0; }
.recommendation-row { display: flex; align-items: flex-start; font-size: 32rpx; line-height: 1.7; margin-top: 22rpx; }
.recommendation-row .muted { margin-right: 20rpx; }
.recommendation-row text { word-break: break-all; }
.text-button { min-height: 88rpx; line-height: 1.6; padding: 22rpx 12rpx; font-size: 28rpx; color: #737780; background: transparent; margin-top: 18rpx; }
.text-button::after { border: none; }
.empty .muted { margin-top: 18rpx; font-size: 28rpx; line-height: 1.7; }
.footer-note { margin-top: 32rpx; }
