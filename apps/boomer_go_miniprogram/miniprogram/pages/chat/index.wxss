.chat-page { height: 100vh; display: flex; flex-direction: column; background: #f5f6f8; }
.chat-header { flex-shrink: 0; background: #fff; border-bottom: 1rpx solid #eef0f3; padding: 22rpx 36rpx; }
.chat-name { font-size: 34rpx; font-weight: 700; margin-bottom: 6rpx; }
.chat-scroll { flex: 1; min-height: 0; min-width: 0; height: 0; width: 100%; max-width: 100%; box-sizing: border-box; }
.chat-history { width: 100%; box-sizing: border-box; padding: 0 28rpx; }
.older-button { min-height: 88rpx; line-height: 88rpx; background: transparent; color: #315acb; font-size: 26rpx; }
.message-row { display: flex; width: 100%; min-width: 0; box-sizing: border-box; margin: 22rpx 0; }
.message-row.mine { justify-content: flex-end; }
.bubble-wrap { max-width: 84%; min-width: 0; box-sizing: border-box; }
.message-time { max-width: 100%; word-break: break-all; color: #737780; font-size: 23rpx; margin-bottom: 10rpx; }
.mine .message-time, .receipt { text-align: right; }
.bubble { max-width: 100%; box-sizing: border-box; border: 1rpx solid #e7e9ee; border-radius: 24rpx 24rpx 24rpx 4rpx; background: #fff; padding: 22rpx 26rpx; overflow: hidden; }
.mine .bubble { border: 0; background: #eb0029; color: #fff; border-radius: 24rpx 24rpx 4rpx 24rpx; }
.message-body { white-space: pre-wrap; word-break: break-all; line-height: 1.65; font-size: 32rpx; }
.receipt { max-width: 100%; word-break: break-all; font-size: 23rpx; color: #737780; margin-top: 10rpx; }
.attachment { margin-top: 8rpx; }
.attachment-image { width: 420rpx; max-width: 100%; border-radius: 16rpx; }
.attachment-button { min-height: 88rpx; padding: 18rpx; background: #f1f2f5; color: #202125; font-size: 28rpx; word-break: break-all; }
.attachment-error { font-size: 26rpx; }
.composer { flex-shrink: 0; display: flex; align-items: flex-end; gap: 18rpx; padding: 20rpx 28rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #e7e9ee; }
.composer-input { flex: 1; min-height: 88rpx; max-height: 240rpx; padding: 20rpx; border-radius: 18rpx; background: #f4f5f7; font-size: 32rpx; line-height: 1.5; }
.send-button { width: 132rpx; flex-shrink: 0; min-height: 88rpx; }
.inline-error, .send-error { flex-shrink: 0; background: #fff0f3; color: #b80024; padding: 12rpx 28rpx; font-size: 26rpx; }
.inline-error { display: flex; align-items: center; gap: 16rpx; }
.inline-error text { flex: 1; }
.inline-error button { background: transparent; min-height: 88rpx; line-height: 88rpx; color: #315acb; font-size: 26rpx; flex-shrink: 0; }
.send-error .muted { font-size: 23rpx; }
.new-messages { flex-shrink: 0; min-height: 88rpx; line-height: 88rpx; color: #315acb; background: #fff; font-size: 28rpx; }
.chat-page > .error { margin: 16rpx 28rpx; }
.preview-banner { flex-shrink: 0; margin: 12rpx 28rpx; }
.attachment-tools { display: flex; align-items: center; gap: 26rpx; background: #fff; padding: 0 28rpx; flex-shrink: 0; }
.attachment-tools button { min-height: 88rpx; line-height: 88rpx; color: #315acb; background: transparent; font-size: 27rpx; }
.attachment-tools .muted { margin-left: auto; font-size: 23rpx; }
.draft-attachment { display: flex; align-items: center; gap: 18rpx; padding: 16rpx 28rpx; border-top: 1rpx solid #e7e9ee; background: #fff; flex-shrink: 0; font-size: 28rpx; }
.draft-attachment > view { min-width: 0; flex: 1; word-break: break-all; }
.draft-attachment button { min-height: 88rpx; line-height: 88rpx; color: #737780; background: transparent; font-size: 26rpx; }
