<view class="page list-page">
  <view wx:if="{{preview}}" class="preview-banner">开发预览 · 合成演示数据，非真实员工记录</view>
  <view class="eyebrow">BOOMER / WORK · LEARN</view><view class="page-title">{{title}}</view>
  <view wx:if="{{kind === 'objectives'}}" class="notice">门店工作协作目标；营业额不计入知识考试、员工考核或处罚。</view>
  <view wx:if="{{kind === 'community'}}" class="notice">从自己的知识库选择已保存商品，在商品详情中分享到 BOOMER 圈。<button class="button-secondary" data-url="/pages/list/index?kind=my-library" bindtap="go">选择商品分享</button></view>
  <button wx:if="{{kind === 'conversations'}}" class="button-secondary" data-url="/pages/detail/index?kind=conversation" bindtap="go">新建 BOOMER 助手对话</button>
  <view wx:if="{{kind === 'check-ins'}}" class="notice">每日成长签到不是考勤，不用于出勤判断。日期以服务器的中国时区为准。</view>
  <view wx:if="{{checkin}}" class="card checkin-card"><view class="row"><view class="section-title">{{checkin.date}}</view><text class="chip">{{checkin.checkedToday ? '今日已成长签到' : '今日未成长签到'}}</text></view><view class="row checkin-stats"><view><view class="muted">连续天数</view><view class="checkin-number">{{checkin.currentStreak}}</view></view><view><view class="muted">最长连续</view><view class="checkin-number">{{checkin.longestStreak}}</view></view><view><view class="muted">累计天数</view><view class="checkin-number">{{checkin.total}}</view></view></view><button class="button" bindtap="submitCheckin" disabled="{{checkingIn || loading || checkin.checkedToday}}" loading="{{checkingIn}}">{{checkin.checkedToday ? '云端已确认今日成长签到' : '每日成长签到'}}</button><view wx:if="{{checkinNotice}}" class="notice">{{checkinNotice}}</view></view>
  <view wx:if="{{kind === 'tasks'}}" class="notice">每日任务与待领经验均以云端状态为准。完成条件、奖励资格和领取结果由服务器核验。</view>
  <view wx:if="{{kind !== 'check-ins' && kind !== 'tasks'}}" class="search-box row"><input placeholder="搜索当前内容" value="{{query}}" bindinput="onSearchInput" bindconfirm="onSearch" confirm-type="search" /><button bindtap="onSearch">搜索</button></view>
  <scroll-view wx:if="{{categories.length}}" scroll-x class="category-scroll">
    <button class="chip category {{category === '' ? 'selected' : ''}}" data-id="" bindtap="onCategory">全部</button>
    <button wx:for="{{categories}}" wx:key="id" class="chip category {{category === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="onCategory">{{item.name}}</button>
  </scroll-view>
  <view wx:if="{{loading}}" class="card loading-state">正在获取云端内容…</view>
  <view wx:if="{{error}}" class="card error"><text>{{error}}</text><button class="button-secondary" bindtap="retry">重试加载</button></view>
  <view wx:if="{{!loading && !error && !items.length}}" class="card empty"><view class="empty-symbol">录</view><view>暂无{{title}}</view><view class="muted">没有记录不等于任务已完成，也不代表接口错误。</view></view>
  <view wx:for="{{items}}" wx:key="id" class="card entry" data-id="{{item.id}}" bindtap="openItem" hover-class="pressed">
    <image wx:if="{{item.cover_url}}" class="entry-image" src="{{item.cover_url}}" mode="aspectFill" />
    <view class="entry-main"><view class="row entry-meta"><text class="chip">{{item.category || title}}</text><text class="muted">{{item.status}}</text></view><view class="section-title">{{item.title}}</view><view wx:if="{{item.body}}" class="muted summary">{{item.body}}</view>
      <view wx:if="{{item.progress !== null}}" class="progress">云端进度 {{item.progress}}<text wx:if="{{item.target !== null}}"> / {{item.target}}</text></view>
      <view wx:if="{{item.amount !== null}}" class="progress">奖励经验 {{item.amount}}</view>
      <view wx:if="{{item.scoreText}}" class="score">{{item.scoreText}} · {{item.passedText}}</view>
      <view class="row entry-footer"><text class="muted">{{item.time}}</text><text class="arrow">查看 →</text></view></view>
  </view>
  <button wx:if="{{hasMore}}" class="button-secondary" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">加载更多</button>
  <view wx:if="{{freshness}}" class="muted freshness">{{freshness}}</view>
</view>
