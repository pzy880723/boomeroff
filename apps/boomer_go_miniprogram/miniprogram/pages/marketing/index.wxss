.marketing-page .section-title { margin-top: 12rpx; }
.marketing-tabs { justify-content: flex-start; margin: 28rpx 0; }
.marketing-tabs button { min-height: 88rpx; }
.scope-options { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 28rpx 0; }
.scope-options button { min-height: 88rpx; }
.task-hint { margin: 22rpx 0; }
.notice { padding: 22rpx; margin-bottom: 22rpx; background: #eef3ff; color: #315acb; border-radius: 18rpx; }
.loading-state { padding: 16rpx 0 24rpx; }
.clip-editor { border-top: 1rpx solid #eef0f3; margin: 28rpx 0; padding-top: 16rpx; }
.clip-editor .muted { margin: 18rpx 0 10rpx; }
.field { min-height: 100rpx; height: auto; line-height: 1.7; }
.references { white-space: nowrap; margin: 22rpx 0; }
.references image { width: 160rpx; height: 180rpx; border-radius: 16rpx; margin-right: 14rpx; }
.reference-picker { padding: 20rpx 0; }
.reference-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12rpx; margin: 20rpx 0; }
.reference-option { border: 3rpx solid transparent; background: #f5f6f8; padding: 6rpx; font-size: 24rpx; }
.reference-option image { width: 100%; height: 140rpx; display: block; border-radius: 10rpx; }
.reference-option text { display: block; padding: 12rpx 0; }
.reference-option.selected { border-color: #eb0029; color: #eb0029; }
.script-message { margin: 18rpx 0; padding: 20rpx; background: #f5f6f8; border-radius: 16rpx; white-space: pre-wrap; }
.pending-changes { margin: 22rpx 0; padding: 22rpx; background: #fff4dc; border-radius: 16rpx; }
.action-stack { display: flex; flex-direction: column; gap: 16rpx; margin-top: 28rpx; }
.card > .button-secondary, .card > .button { margin-top: 20rpx; }
.render-video { width: 100%; height: 650rpx; margin: 24rpx 0; background: #202125; border-radius: 20rpx; }
.render-cover { width: 180rpx; max-height: 260rpx; border-radius: 16rpx; margin-bottom: 20rpx; }
.library-item { display: flex; gap: 22rpx; min-height: 160rpx; }
.library-item image { width: 160rpx; height: 180rpx; flex-shrink: 0; border-radius: 16rpx; }
.library-summary { min-width: 0; word-break: break-word; }
.library-summary .section-title { font-size: 32rpx; }
