page{background:#F5F6F8;color:#202125;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue",sans-serif;font-size:30rpx;line-height:1.55}view,text,button,input,textarea{box-sizing:border-box}button{font-size:30rpx;margin:0;padding:0;border-radius:20rpx;line-height:1.4}button::after{border:0}button[disabled]{opacity:.45}button.button{background:#EB0029;color:white}button.button-secondary{background:white;color:#202125;border:1rpx solid #DFE2E7}.page{padding:28rpx 36rpx 200rpx;min-height:100vh}.card{background:white;border-radius:28rpx;padding:30rpx;margin-bottom:22rpx;border:1rpx solid #EEF0F3}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.section-title{font-size:36rpx;font-weight:700;margin:36rpx 0 22rpx;letter-spacing:-1rpx}.muted{color:#737780;font-size:25rpx}.small{font-size:23rpx}.button,.button-secondary{min-height:88rpx;padding:24rpx 30rpx;display:flex;align-items:center;justify-content:center;font-weight:600}.chip{display:inline-flex;align-items:center;justify-content:center;padding:12rpx 24rpx;background:#EEF0F3;color:#666C78;border-radius:99rpx;font-size:25rpx;margin-right:12rpx;min-height:62rpx}.chip.active{background:#EB0029;color:white}.error{padding:24rpx;background:#FFF0F3;color:#B80024;border-radius:20rpx;white-space:pre-wrap;font-size:26rpx;margin-bottom:24rpx}.empty{padding:60rpx 24rpx;color:#737780;text-align:center;font-size:27rpx}.preview-banner{padding:14rpx 22rpx;margin-bottom:24rpx;background:#FFF4DC;color:#8A5D12;border-radius:14rpx;font-size:23rpx}.title{font-size:48rpx;font-weight:750;line-height:1.3;margin:12rpx 0 18rpx;letter-spacing:-1rpx}.caption{font-size:23rpx;color:#737780}.red{color:#EB0029}.divider{height:1rpx;background:#EEF0F3;margin:22rpx 0}.body{font-size:29rpx;line-height:1.9;white-space:pre-wrap}.search{background:white;border-radius:22rpx;padding:24rpx;margin:24rpx 0}.field{background:#F4F5F7;border:1rpx solid #ECEEF2;border-radius:18rpx;min-height:90rpx;padding:22rpx;font-size:30rpx;width:100%}.loading{padding:30rpx;text-align:center;color:#737780}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.tool{min-height:130rpx;background:white;border-radius:24rpx;padding:26rpx}.badge{display:inline-block;border-radius:9rpx;font-size:22rpx;padding:5rpx 12rpx;background:#FFF0F3;color:#EB0029}.link{color:#EB0029;font-size:27rpx}.cover{width:100%;border-radius:20rpx}.money{font-size:48rpx;font-weight:750;font-variant-numeric:tabular-nums}.safe-bottom{padding-bottom:env(safe-area-inset-bottom)}
