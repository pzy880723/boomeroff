<view class="tab-bar"><view wx:for="{{tabs}}" wx:key="path" class="tab {{selected===index?'selected':''}} {{index===2?'center':''}}" data-index="{{index}}" bindtap="switchTab" role="button" aria-label="{{item.name}}"><view class="icon {{item.icon}}"><view class="icon-inner"></view></view><text>{{item.name}}</text></view></view>
