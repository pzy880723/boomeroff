.tab-bar{position:fixed;z-index:80;bottom:0;left:0;right:0;display:flex;justify-content:space-around;background:#fff;border-top:1rpx solid #EAECF0;padding:14rpx 10rpx calc(14rpx + env(safe-area-inset-bottom));box-sizing:border-box}.tab{width:20%;min-height:94rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#8A8E98;font-size:23rpx;gap:8rpx}.selected{color:#EB0029}.icon{position:relative;width:36rpx;height:34rpx;border:3rpx solid currentColor;box-sizing:border-box;border-radius:5rpx}.grid::before{content:'';position:absolute;left:14rpx;top:0;height:28rpx;border-left:3rpx solid currentColor}.grid::after{content:'';position:absolute;top:13rpx;left:0;width:30rpx;border-top:3rpx solid currentColor}.book{border-radius:3rpx 9rpx 9rpx 3rpx}.book .icon-inner{position:absolute;left:8rpx;top:0;height:28rpx;border-left:2rpx solid currentColor}.camera{border-radius:9rpx;width:40rpx;height:32rpx}.camera .icon-inner{position:absolute;border:3rpx solid currentColor;border-radius:50%;width:15rpx;height:15rpx;left:9rpx;top:5rpx}.center .icon{background:#EB0029;border-color:#EB0029;color:white;box-shadow:0 0 0 13rpx #EB0029;margin-bottom:8rpx;margin-top:4rpx}.message{border-radius:9rpx}.message::after{content:'';position:absolute;left:5rpx;bottom:-8rpx;width:9rpx;height:9rpx;border-left:3rpx solid currentColor;transform:skewY(-35deg);background:white}.person{border-radius:20rpx 20rpx 6rpx 6rpx;height:17rpx;margin-top:17rpx}.person::before{content:'';position:absolute;left:8rpx;top:-25rpx;width:15rpx;height:15rpx;border:3rpx solid currentColor;border-radius:50%;box-sizing:border-box}
