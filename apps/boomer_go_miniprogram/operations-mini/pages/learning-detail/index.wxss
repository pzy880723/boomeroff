.reader{min-height:100vh;background:#fff;padding-bottom:calc(130rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.reader-cover{width:100%;height:408rpx;display:block;background:#ebe5df}
.reader-body{padding:32rpx 38rpx}
.reader-title{font-size:51rpx;font-weight:800;line-height:1.25}
.reader-tags{font-size:24rpx;color:#625e5b;margin-top:16rpx}
.reader-callout{background:#fcebea;border-radius:19rpx;padding:24rpx;font-size:27rpx;display:flex;flex-direction:column;gap:10rpx;margin:24rpx 0;color:#a50921;white-space:pre-wrap}
.reader-caption{font-size:23rpx;font-weight:700}
.reader-text{white-space:pre-wrap;line-height:1.65;font-size:29rpx}
.reader-actions{position:fixed;bottom:0;left:0;right:0;display:flex;background:white;border-top:2rpx solid #ebe5df;padding:14rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));gap:14rpx}
.reader-actions .button{flex:1;margin:0}
.question{margin:25rpx 0;padding:20rpx;border:2rpx solid #ebe5df;border-radius:18rpx}
.q-title{font-size:28rpx;font-weight:700}
.choice{font-size:26rpx;background:#f7f5f2;border-radius:15rpx;margin-top:12rpx;text-align:left}
.choice.on{background:#fcebea;color:#a50921}
