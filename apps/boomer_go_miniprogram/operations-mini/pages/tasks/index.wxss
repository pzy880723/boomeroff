.task-page .card { margin-top: 18rpx; }
.alert { background: #fff0f1; border-radius: 14rpx; padding: 20rpx; }
.field-title { font-weight: 750; }
.form .field-title:not(:first-child) { margin-top: 28rpx; }
.field { display: block; width: 100%; box-sizing: border-box; background: #f5f6f8; border-radius: 12rpx; min-height: 82rpx; padding: 22rpx; margin-top: 12rpx; font-size: 28rpx; }
.area { height: 174rpx; }
.task-name { font-size: 34rpx; font-weight: 800; flex: 1; min-width: 0; overflow-wrap: anywhere; }
.description { white-space: pre-wrap; overflow-wrap: anywhere; color: #4c5059; margin-top: 14rpx; line-height: 1.6; }
.proofs { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.hint { margin-top: 12rpx; }
.button[disabled] { background: #ebedf0; color: #59606e; }
